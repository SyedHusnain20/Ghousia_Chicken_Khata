{
  "name": "khata-app",
  "version": "0.1.0",
  "description": "Local khata (ledger) software for a chicken shop - supplier & customer due tracking",
  "author": "R&R Digital Solutions",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "test:scenario": "ts-node test/scenario.ts",
    "build:main": "tsc && node scripts/copy-assets.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:main && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n vite,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.ghousia.chickenkhata",
    "productName": "Ghousia Chicken Khata",
    "copyright": "Copyright \u00a9 2026 R&R Digital Solutions",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publisherName": "R&R Digital Solutions"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": false
    }
  }
}